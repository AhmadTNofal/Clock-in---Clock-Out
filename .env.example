# ---------------------------------------------------------------------------
# Copy to ".env" and edit. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Flask ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-going-live
FLASK_ENV=development

# MySQL ---------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=clocking
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=clocking
# TLS to the database. Leave blank to decide automatically: "disabled" for a
# database on this machine, "verify-identity" for anything remote - a managed
# database (DigitalOcean, RDS, Azure) is reached over the public internet, and
# face templates are biometric data, so the link must be encrypted.
#   disabled         no TLS. Only acceptable for localhost.
#   required         encrypt, but do not verify the server's certificate.
#   verify-identity  encrypt and verify the certificate and hostname.
MYSQL_SSL_MODE=
# Optional path to a CA certificate, if your provider issues its own. For
# DigitalOcean, download "ca-certificate.crt" from the database's Connection
# Details page and point this at it.
MYSQL_SSL_CA=

# Kiosk ---------------------------------------------------------------------
# Shared secret the kiosk browser must present. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KIOSK_TOKEN=change-me-kiosk-token
KIOSK_DEVICE_LABEL=Workshop entrance

# Hands-free clocking -------------------------------------------------------
# true: the kiosk watches for a face and clocks people with no button press.
# false: nothing happens until somebody presses Scan.
KIOSK_AUTO_MODE=true
# Seconds the on-screen countdown runs before an automatic entry is written.
# This is the safety net: it lets somebody who only walked past press Cancel.
# Set to 0 to record the instant a face is recognised (not recommended).
AUTO_CONFIRM_SECONDS=4
# Minimum gap between two AUTOMATIC entries for the same person. Deliberately
# long: being seen by a camera states no intent, so somebody crossing the view
# an hour into their shift must not be clocked out. Pressing Clock out overrides
# it. Raise it towards a full shift length if people pass the kiosk often.
AUTO_MIN_INTERVAL_SECONDS=600
# How often recognition runs once the kiosk thinks somebody is there (ms).
AUTO_POLL_MS=900
# How often the browser checks whether anybody has arrived (ms). Cheap: this is
# a small greyscale comparison in the browser, not face recognition.
AUTO_PRESENCE_MS=350
# Mean grey-level change from the empty scene that counts as "somebody is
# there". Raise it if the kiosk keeps waking at shadows or passing forklifts;
# lower it if it ignores people who approach slowly.
AUTO_PRESENCE_THRESHOLD=7.0
# In hands-free mode the nearest face must be this many times wider than the
# next one to count as "the person at the kiosk", so somebody walking past
# behind does not block recognition. Raise it to be stricter.
FACE_DOMINANT_RATIO=1.35

# Recognition tuning --------------------------------------------------------
# Cosine similarity required to accept a match (SFace: 0.363 is the OpenCV
# reference value; raise towards 0.45 to reduce false accepts).
FACE_MATCH_THRESHOLD=0.40
# The best match must beat the runner-up by at least this margin.
FACE_MATCH_MARGIN=0.05
# Minimum face width in pixels, as seen by the detector.
FACE_MIN_PIXELS=80
# Minimum Laplacian variance (blur gate). Lower = accepts blurrier images.
FACE_MIN_SHARPNESS=45.0
# Frames the kiosk sends per scan, and how many must agree.
SCAN_FRAMES=3
SCAN_MIN_AGREE=2
# Require frame-to-frame movement (basic printed-photo deterrent).
LIVENESS_REQUIRE_MOTION=true
LIVENESS_MIN_MOTION=1.6

# Attendance rules ----------------------------------------------------------
# Ignore repeat scans from the same person within this many seconds.
CLOCK_COOLDOWN_SECONDS=90
# Local timezone used for day boundaries and reports.
TIMEZONE=Europe/London
